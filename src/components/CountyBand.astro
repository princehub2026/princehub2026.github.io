---
import { counties } from "../data/counties";
---
<section class="bg-navy-900 glow-bottom border-b border-gold-500/15 py-20 sm:py-28 noise">
  <div class="mx-auto max-w-5xl px-6 text-center">
    <p class="text-gold-500 text-xs sm:text-sm tracking-wide-lg uppercase mb-4 reveal">
      Serving Clients Across Five Counties
    </p>
    <div class="glow-rule max-w-[60px] mx-auto mb-10 sm:mb-14 reveal"></div>

    <!-- Desktop: single restrained row -->
    <div class="hidden sm:flex items-baseline justify-center flex-wrap gap-x-9 gap-y-4 reveal">
      {counties.map((c, i) => (
        <>
          <a href={`/counties/${c.slug}`} class="font-serif text-2xl md:text-3xl text-cream-100 tracking-wide-sm relative pb-1 wipe-link transition-all hover:text-gold-400 hover:[text-shadow:0_0_26px_rgba(201,164,74,0.55)]">
            {c.name.replace(" County", "")}
          </a>
          {i < counties.length - 1 && (
            <span class="text-gold-500/45 text-lg" aria-hidden="true">·</span>
          )}
        </>
      ))}
    </div>

    <!-- Mobile: stacked full-width tap targets -->
    <div class="sm:hidden flex flex-col text-left reveal">
      {counties.map((c) => (
        <a href={`/counties/${c.slug}`} class="py-4 font-serif text-xl text-cream-100 flex items-center justify-between border-t border-gold-500/25 last:border-b min-h-[52px]">
          <span>{c.name.replace(" County", "")}</span>
          <span class="text-gold-500" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
