---
import { practiceAreas } from "../data/practiceAreas";
import { counties } from "../data/counties";
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<footer class="bg-navy-1000 text-cream-100/85 pt-16 pb-28 lg:pb-16 border-t border-gold-500/20 noise">
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <img src="/images/logo-crest.png" alt="Yakubu Law crest" class="h-14 w-auto mb-4 crest-glow" />
        <p class="font-serif text-lg text-cream-50">YAKUBU LAW</p>
        <p class="text-xs tracking-wide-sm uppercase mt-1 foil-text">Trial Ready Criminal Defense</p>
        <p class="text-[11px] tracking-wide-sm uppercase mt-3 text-cream-100/60">Swift. Sharp. Strategic.</p>
      </div>

      <div>
        <p class="text-gold-400 text-xs tracking-wide-sm uppercase mb-4">Practice Areas</p>
        <ul class="space-y-2 text-sm">
          {practiceAreas.map((pa) => (
            <li><a href={`/practice-areas/${pa.slug}`} class="hover:text-gold-400 transition-colors">{pa.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-gold-400 text-xs tracking-wide-sm uppercase mb-4">Counties Served</p>
        <ul class="space-y-2 text-sm">
          {counties.map((c) => (
            <li><a href={`/counties/${c.slug}`} class="hover:text-gold-400 transition-colors">{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-gold-400 text-xs tracking-wide-sm uppercase mb-4">Contact</p>
        <p class="text-sm">
          <a href={`tel:${PHONE_TEL}`} class="text-cream-50 font-medium hover:text-gold-400 transition-colors">{PHONE}</a>
        </p>
        <p class="text-sm mt-2 text-cream-100/65">
          Consultations by phone, 24/7.<br/>
          Meetings by appointment across the five counties served.
        </p>
        <a href="/contact" class="inline-block mt-4 text-xs tracking-wide-sm uppercase text-gold-400 border-b border-gold-500 pb-0.5 hover:text-gold-400/80">
          Free Consultation →
        </a>
        <p class="text-sm mt-5">
          <a href="/for-families" class="hover:text-gold-400 transition-colors">For Parents &amp; Loved Ones</a>
        </p>
      </div>
    </div>

    <div class="hairline my-10"></div>

    <div class="flex flex-col sm:flex-row justify-between gap-3 text-[11px] text-cream-100/60">
      <p>&copy; {new Date().getUTCFullYear()} Yakubu Law. All rights reserved. &nbsp;&middot;&nbsp; <a href="/privacy" class="hover:text-gold-400 transition-colors">Privacy Policy</a></p>
      <p>Attorney Advertising. Prior results do not guarantee a similar outcome. This site does not create an attorney-client relationship.</p>
    </div>

  </div>
</footer>
