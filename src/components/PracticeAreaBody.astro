---
import type { PracticeArea } from "../data/practiceAreas";

interface Props {
  area: PracticeArea;
  parentPath?: string; // e.g. "/practice-areas/criminal-defense"
  breadcrumb: { label: string; href?: string }[];
}
const { area, parentPath, breadcrumb } = Astro.props;
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<section class="bg-navy-950 pt-14 pb-12 sm:pt-20 sm:pb-16" style="background-color:#070f21;">
  <div class="mx-auto max-w-4xl px-6">
    <nav class="text-[11px] tracking-wide-sm uppercase text-cream-100/45 mb-6 flex flex-wrap gap-x-2" style="color:rgba(244,240,232,0.45);">
      {breadcrumb.map((b, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          {b.href ? <a href={b.href} class="hover:text-gold-400">{b.label}</a> : <span>{b.label}</span>}
        </>
      ))}
    </nav>
    <h1 class="font-serif text-cream-50 text-3xl sm:text-5xl leading-tight" style="color:#faf8f4;">{area.name}</h1>
    <p class="mt-4 text-cream-100/75 text-base sm:text-lg max-w-2xl leading-relaxed" style="color:rgba(244,240,232,0.78);">
      {area.intro}
    </p>
  </div>
</section>

{area.children && (
  <section class="bg-cream-50 py-14 sm:py-20" style="background-color:#faf8f4;">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-gold-600 text-xs tracking-wide-lg uppercase mb-8" style="color:#a9873a;">
        {area.slug === "criminal-defense" ? "Areas Within Criminal Defense" : "Related Areas"}
      </p>
      <div class="grid sm:grid-cols-2 gap-x-10 gap-y-6">
        {area.children.map((c) => (
          <a
            href={`${parentPath}/${c.slug}`}
            class="block border-t pt-4 group"
            style="border-color: rgba(196,162,74,0.3);"
          >
            <h3 class="font-serif text-lg text-navy-900 group-hover:text-gold-600 transition-colors" style="color:#0a1630;">{c.name}</h3>
            <p class="text-sm text-navy-900/60 mt-1" style="color:rgba(10,22,48,0.6);">{c.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="py-14 sm:py-16 text-center" style="background-color:#f4f0e8;">
  <p class="text-navy-900 text-sm sm:text-base mb-6" style="color:#0a1630;">
    Facing a charge related to {area.name.toLowerCase()}? Speak directly with the attorney.
  </p>
  <a
    href={`tel:${PHONE_TEL}`}
    class="inline-block px-8 py-3.5 bg-navy-900 text-cream-50 text-sm tracking-wide-sm uppercase font-medium hover:bg-navy-800 transition-colors"
    style="background-color:#0a1630; color:#faf8f4;"
  >
    Call {PHONE}
  </a>
</section>
