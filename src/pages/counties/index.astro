---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { counties } from "../../data/counties";
---
<BaseLayout
  title="Counties Served"
  description="Yakubu Law serves clients across Bucks, Chester, Delaware, Montgomery, and Philadelphia counties in Pennsylvania."
>
  <section class="bg-navy-950 glow-top noise pt-16 pb-12 sm:pt-20 sm:pb-16 text-center">
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase">Counties Served</p>
    <h1 class="font-serif text-cream-50 text-3xl sm:text-4xl mt-2">
      Five Counties. One Direct Line.
    </h1>
    <div class="glow-rule w-16 mx-auto mt-6"></div>
  </section>

  <section class="bg-cream-50 py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-6 grid sm:grid-cols-2 gap-x-10 gap-y-8">
      {counties.map((c) => (
        <a href={`/counties/${c.slug}`} class="block border-t pt-5 group border-gold-500/30">
          <h2 class="font-serif text-xl text-navy-900 group-hover:text-gold-600 transition-colors">{c.name}</h2>
          <p class="text-sm text-navy-900/60 mt-1.5">
            {c.status === "single-court" ? c.courtCountNote : `${c.courtCount} Magisterial District Courts`}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
