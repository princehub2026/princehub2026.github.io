---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCounty } from "../../../data/counties";

const county = getCounty("delaware")!;

export function getStaticPaths() {
  const county = getCounty("delaware")!;
  return (county.courts ?? []).map((court) => ({
    params: { court: court.slug },
    props: { court },
  }));
}

const { court } = Astro.props;
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${court.address}, ${court.cityStateZip}`
)}`;

const NUMBER_WORDS: Record<number, string> = { 16: "sixteen", 18: "eighteen", 26: "twenty-six", 29: "twenty-nine" };
const countWord = NUMBER_WORDS[county.courtCount] ?? String(county.courtCount);
const city = court.cityStateZip.split(",")[0];
const muniCount = court.townships ? court.townships.split(",").length : 0;
const deptCount = court.policeDepartments ? court.policeDepartments.length : 0;
const siblings = (county.courts ?? []).filter((c) => c.slug !== court.slug);
const isVacant = court.judge.toLowerCase().startsWith("vacant");

const stats = [
  muniCount > 0 && { value: String(muniCount), label: muniCount === 1 ? "Municipality" : "Municipalities" },
  deptCount > 0 && { value: String(deptCount), label: deptCount === 1 ? "Police Department" : "Police Departments" },
  court.criminalProceedings && { value: court.criminalProceedings.slice(0, 3), label: "Criminal Day" },
].filter(Boolean);

const faq = [
  court.townships && {
    q: `Which municipalities does Magisterial District Court ${court.dcNumber} cover?`,
    a: court.townships + ".",
  },
  court.policeDepartments && court.policeDepartments.length > 0 && {
    q: `Which police departments file cases at Court ${court.dcNumber}?`,
    a: `Cases at this court most often come from the ${court.policeDepartments.join(", ")}.`,
  },
  {
    q: "Is a preliminary hearing a trial?",
    a: "No. No one is found guilty or not guilty at a preliminary hearing. The Commonwealth only has to show there is enough evidence for the case to move forward to the Court of Common Pleas.",
  },
  county.courthouse && {
    q: "Where does my case go if it is held for court?",
    a: `Cases held for court move to the ${county.courthouse.name}, ${county.courthouse.address}, ${county.courthouse.cityStateZip}. Summary offenses and most traffic citations are decided at the magisterial district court and go no further.`,
  },
].filter(Boolean);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LegalService",
      name: "Yakubu Law",
      description: `Criminal defense representation for cases heard at Magisterial District Court ${court.dcNumber} in Delaware County, Pennsylvania.`,
      telephone: "+1-484-944-0834",
      areaServed: { "@type": "AdministrativeArea", name: "Delaware County, Pennsylvania" },
      knowsLanguage: "en",
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---
<BaseLayout
  title={`D.C. ${court.dcNumber} — Delaware County Magisterial District Court`}
  description={`Magisterial District Court ${court.dcNumber} in Delaware County, PA — Judge ${court.judge}. Address, phone, municipalities served, and directions.`}
>
  <section class="bg-navy-950 glow-top noise pt-14 pb-12 sm:pt-16 sm:pb-14 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] flex items-center justify-center pointer-events-none">
      <img src="/images/logo-crest.png" alt="" aria-hidden="true" class="h-[380px] w-auto" />
    </div>
    <div class="mx-auto max-w-3xl px-6 relative">
      <nav class="text-[11px] tracking-wide-sm uppercase text-cream-100/45 mb-8 flex flex-wrap gap-x-2">
        <a href="/counties" class="hover:text-gold-400">Counties</a><span aria-hidden="true">/</span>
        <a href="/counties/delaware" class="hover:text-gold-400">Delaware County</a><span aria-hidden="true">/</span>
        <span>D.C. {court.dcNumber}</span>
      </nav>

      {court.photo ? (
        <div class="mb-8 border border-gold-500/35">
          <img src={court.photo} alt={`Magisterial District Court ${court.dcNumber}, ${city}, Pennsylvania`} class="w-full h-56 sm:h-72 object-cover" style="filter: grayscale(1) contrast(1.08) brightness(0.92);" loading="eager" />
        </div>
      ) : (
        <div class="mb-8 text-center py-8 border-t border-b border-gold-500/30">
          <p class="text-gold-500 text-[10px] tracking-wide-lg uppercase mb-3">Magisterial District</p>
          <p class="font-serif text-gold-400 text-5xl sm:text-6xl leading-none" style="text-shadow: 0 0 30px rgba(201,164,74,0.4);">{court.dcNumber}</p>
          <p class="text-cream-100/50 text-[11px] tracking-wide-sm uppercase mt-3">Delaware County · {city}</p>
        </div>
      )}

      <h1 class="font-serif text-cream-50 text-3xl sm:text-4xl text-center">{court.judge}</h1>
      <div class="glow-rule w-14 mx-auto mt-5"></div>
      <p class="text-cream-100/55 text-sm text-center mt-2">
        {isVacant ? "Seat currently vacant — office operating as usual" : "Presiding Magisterial District Judge"}
      </p>

      {stats.length > 0 && (
        <div class="mt-10 flex flex-wrap justify-center gap-x-14 gap-y-6 text-center border-t pt-8 border-gold-500/20">
          {stats.map((s) => (
            <div>
              <p class="font-serif text-gold-400 text-2xl">{s.value}</p>
              <p class="text-cream-100/45 text-[10px] tracking-wide-sm uppercase mt-1">{s.label}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="py-12 sm:py-14 bg-cream-50">
    <div class="mx-auto max-w-3xl px-6">
      <div class="grid sm:grid-cols-2 gap-8">
        <div>
          <p class="text-gold-600 text-[11px] tracking-wide-sm uppercase mb-2">Address</p>
          <p class="text-navy-900">{court.address}<br/>{court.cityStateZip}</p>
          <a href={directionsUrl} target="_blank" rel="noopener" class="inline-block mt-3 text-xs tracking-wide-sm uppercase border-b pb-0.5 border-gold-500 text-gold-600">Get Directions →</a>
        </div>
        <div>
          <p class="text-gold-600 text-[11px] tracking-wide-sm uppercase mb-2">Contact</p>
          <a href={`tel:${court.phone.replace(/\D/g, "")}`} class="text-navy-900 block hover:text-gold-600">{court.phone}</a>
          {court.fax && <p class="text-navy-900/60 text-sm mt-1">Fax {court.fax}</p>}
          {court.criminalProceedings && <p class="text-navy-900/60 text-sm mt-3">Criminal proceedings: {court.criminalProceedings}s</p>}
        </div>
      </div>

      {court.townships && (
        <div class="mt-10 pt-8 border-t border-gold-500/30">
          <p class="text-gold-600 text-[11px] tracking-wide-sm uppercase mb-2">Municipalities Served by This Court</p>
          <p class="text-navy-900/75 text-sm leading-relaxed">{court.townships}</p>
        </div>
      )}

      <div class="mt-8 pt-8 border-t border-gold-500/30">
        <p class="text-gold-600 text-[11px] tracking-wide-sm uppercase mb-2">Police Departments in This District</p>
        {deptCount > 0 && (
          <ul class="text-navy-900/75 text-sm leading-relaxed grid sm:grid-cols-2 gap-x-8 gap-y-1">
            {court.policeDepartments.map((dept) => (<li>{dept}</li>))}
          </ul>
        )}
        {deptCount === 0 && !court.pspNote && (
          <p class="text-navy-900/60 text-sm leading-relaxed">We're still confirming which department(s) report to this court — check back soon, or call the attorney directly.</p>
        )}
        {court.pspNote && <p class="text-navy-900/55 text-xs leading-relaxed mt-3">{court.pspNote}</p>}
      </div>

      {court.note && (
        <p class="text-navy-900/70 text-xs leading-relaxed mt-8 border-l-2 pl-4 border-gold-500">{court.note}</p>
      )}
    </div>
  </section>

  <section class="bg-navy-900 glow-bottom noise py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-gold-400 text-xs tracking-wide-lg uppercase mb-6 text-center">About This Court</p>
      <div class="text-cream-100/75 text-sm sm:text-base leading-relaxed space-y-5">
        <p>
          Magisterial District Court {court.dcNumber} is one of {countWord} magisterial district courts in Delaware County.
          {isVacant ? " The seat is currently vacant; the office continues to operate at its regular address, with coverage assigned by the county." : ` Judge ${court.judge} presides.`}
          {muniCount > 0 && ` It serves ${muniCount === 1 ? "one municipality" : `${muniCount} municipalities`}, listed above.`}
          {court.criminalProceedings && ` Criminal proceedings are heard on ${court.criminalProceedings}s.`}
          {" "}If you were charged by an officer in one of those municipalities, this is almost certainly where your case begins.
        </p>
        {(county.courtProse ?? []).map((para) => (<p>{para}</p>))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16 bg-cream-100">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <p class="text-gold-600 text-xs tracking-wide-lg uppercase mb-4">Before Your Court Date</p>
      <p class="font-serif text-lg sm:text-xl leading-relaxed text-navy-900">
        Every magisterial district court runs a little differently.
      </p>
      <p class="mt-5 text-navy-900/75 text-sm leading-relaxed">
        Parking, which entrance to use, how early to arrive, how a given courtroom handles its list — those questions deserve a
        real answer rather than a guess. Call this court directly at <a href={`tel:${court.phone.replace(/\D/g, "")}`} class="border-b border-gold-500 text-gold-600">{court.phone}</a>, or call Yakubu Law at <a href={`tel:${PHONE_TEL}`} class="border-b border-gold-500 text-gold-600">{PHONE}</a> to talk through your case.
      </p>
    </div>
  </section>

  <section class="bg-navy-900 py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-gold-400 text-xs tracking-wide-lg uppercase mb-8 text-center">Common Questions</p>
      <div class="flex flex-col gap-1">
        {faq.map((item) => (
          <details class="group border-b py-4 border-gold-500/25">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-cream-50 text-sm font-medium">
              {item.q}
              <span class="text-gold-400 text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-cream-100/65 text-sm leading-relaxed mt-3">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-14 bg-cream-50">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-gold-600 text-xs tracking-wide-lg uppercase mb-6 text-center">Other Delaware County Courts</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-3">
        {siblings.map((c) => (
          <a href={`/counties/delaware/${c.slug}`} class="block border-t pt-2 group border-gold-500/30">
            <p class="text-gold-600 text-[10px] tracking-wide-sm uppercase">D.C. {c.dcNumber}</p>
            <p class="text-navy-900/70 text-xs mt-0.5 group-hover:text-navy-900">{c.cityStateZip.split(",")[0]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy-950 glow-top noise py-14 sm:py-16 text-center">
    <p class="text-cream-100/80 text-sm sm:text-base mb-6">
      Have a hearing at this court? Speak directly with the attorney beforehand.
    </p>
    <a href={`tel:${PHONE_TEL}`} class="inline-block px-8 py-3.5 btn-foil text-sm tracking-wide-sm uppercase font-medium">
      Call {PHONE}
    </a>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</BaseLayout>
