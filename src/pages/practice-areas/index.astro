---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { practiceAreas } from "../../data/practiceAreas";
---
<BaseLayout
  title="Practice Areas"
  description="Yakubu Law practice areas — criminal defense, DUI, firearms, drug charges, violent crimes, and more across Pennsylvania."
>
  <section class="bg-navy-950 glow-top noise pt-16 pb-12 sm:pt-20 sm:pb-16 text-center">
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase">Practice Areas</p>
    <h1 class="font-serif text-cream-50 text-3xl sm:text-4xl mt-2">
      Representation Built for Trial
    </h1>
    <div class="glow-rule w-16 mx-auto mt-6"></div>
  </section>

  <section class="bg-cream-50 py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-6 grid sm:grid-cols-2 gap-x-10 gap-y-8">
      {practiceAreas.map((pa) => (
        <a href={`/practice-areas/${pa.slug}`} class="block border-t pt-5 group border-gold-500/30">
          <h2 class="font-serif text-xl text-navy-900 group-hover:text-gold-600 transition-colors">{pa.name}</h2>
          <p class="text-sm text-navy-900/60 mt-1.5">{pa.short}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Photo band -->
  <section class="relative h-[38vh] min-h-[300px] sm:h-[48vh] w-full overflow-hidden">
    <img
      src="/images/attorney-autumn.jpg"
      alt="Attorney Prince Charles Yakubu"
      class="absolute inset-0 w-full h-full object-cover"
      style="filter: grayscale(0.25) contrast(1.05) brightness(0.9); object-position: 50% 25%;"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background-color:#0b1730; mix-blend-mode:multiply; opacity:0.55;"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(201,164,74,0.16) 0%, rgba(201,164,74,0) 60%), linear-gradient(180deg, rgba(6,13,29,0.3) 0%, rgba(6,13,29,0.5) 100%);"></div>
  </section>
</BaseLayout>
