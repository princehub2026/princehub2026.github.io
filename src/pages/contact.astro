---
import BaseLayout from "../layouts/BaseLayout.astro";
import { counties } from "../data/counties";
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<BaseLayout
  title="Contact"
  description="Contact Yakubu Law for a free consultation. Available 24/7 by phone."
>
  <section class="bg-navy-950 glow-top noise pt-16 pb-12 sm:pt-20 sm:pb-16 text-center">
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase">Contact</p>
    <h1 class="font-serif text-cream-50 text-4xl sm:text-5xl mt-3">Free Consultation</h1>
    <div class="glow-rule w-16 mx-auto mt-6"></div>
  </section>

  <section class="bg-cream-50 py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-6 grid sm:grid-cols-5 gap-12">
      <div class="sm:col-span-2">
        <a
          href={`tel:${PHONE_TEL}`}
          class="block text-center px-6 py-5 bg-navy-950 text-cream-50 mb-8 border border-gold-500/40 shadow-[0_0_28px_-6px_rgba(201,164,74,0.35)] transition-shadow hover:shadow-[0_0_34px_-4px_rgba(201,164,74,0.5)]"
         
        >
          <span class="block text-[11px] tracking-wide-lg uppercase text-gold-400 mb-1">Call 24/7</span>
          <span class="font-serif text-xl">{PHONE}</span>
        </a>
        <p class="text-navy-900/75 text-sm leading-relaxed">
          We understand that contacting an attorney is often an important first step.
          Leave your name, phone number, and a brief message, and we ask that you allow
          up to two business days for a return call.
        </p>
        <div class="hairline-static my-8"></div>
        <p class="text-navy-900/50 text-xs tracking-wide-sm uppercase mb-1">Office</p>
        <p class="text-navy-900/70 text-sm">
          [Address placeholder — to be replaced]<br/>Pennsylvania
        </p>
        <img
          src="/images/consultation-call.jpg"
          alt="Attorney Prince Charles Yakubu taking a client call"
          class="w-full aspect-[4/3] object-cover mt-8"
        />
      </div>

      <div class="sm:col-span-3">
        <form id="contact-form" class="flex flex-col gap-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-[11px] tracking-wide-sm uppercase text-navy-900/60 mb-1.5">Name</label>
              <input id="name" name="name" type="text" required class="w-full border-0 border-b border-navy-900/25 bg-transparent py-3 focus:outline-none focus:border-gold-500" />
            </div>
            <div>
              <label for="phone" class="block text-[11px] tracking-wide-sm uppercase text-navy-900/60 mb-1.5">Phone</label>
              <input id="phone" name="phone" type="tel" required class="w-full border-0 border-b border-navy-900/25 bg-transparent py-3 focus:outline-none focus:border-gold-500" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-[11px] tracking-wide-sm uppercase text-navy-900/60 mb-1.5">Email</label>
            <input id="email" name="email" type="email" class="w-full border-0 border-b border-navy-900/25 bg-transparent py-3 focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label for="county" class="block text-[11px] tracking-wide-sm uppercase text-navy-900/60 mb-1.5">County</label>
            <select id="county" name="county" class="w-full border-0 border-b border-navy-900/25 bg-transparent py-3 focus:outline-none focus:border-gold-500">
              <option value="">Select a county</option>
              {counties.map((c) => <option value={c.slug}>{c.name}</option>)}
            </select>
          </div>
          <div>
            <label for="message" class="block text-[11px] tracking-wide-sm uppercase text-navy-900/60 mb-1.5">Message</label>
            <textarea id="message" name="message" rows="5" class="w-full border-0 border-b border-navy-900/25 bg-transparent py-3 focus:outline-none focus:border-gold-500"></textarea>
          </div>
          <button
            type="submit"
            class="self-start mt-2 px-8 py-3.5 bg-navy-900 text-cream-50 text-sm tracking-wide-sm uppercase font-medium hover:bg-navy-800 transition-colors"
           
          >
            Send
          </button>
          <p id="form-note" class="hidden text-sm text-navy-900/70 mt-2">
            Online submission isn't connected yet — please call <a href={`tel:${PHONE_TEL}`} class="underline">{PHONE}</a> in the meantime, and this form will route directly once set up.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form");
    const note = document.getElementById("form-note");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      note?.classList.remove("hidden");
    });
  </script>
</BaseLayout>
