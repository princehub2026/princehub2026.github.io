---
import BaseLayout from "../layouts/BaseLayout.astro";
import CountyBand from "../components/CountyBand.astro";

const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<BaseLayout
  title="Trial Ready Criminal Defense"
  description="Yakubu Law is a Pennsylvania criminal defense practice prepared to take every case to trial — from DUI to homicide. Free consultation, available 24/7."
>
  <!-- Hero -->
  <section class="relative">
    <div class="relative h-[86vh] min-h-[600px] sm:h-[92vh] sm:min-h-[660px] w-full overflow-hidden bg-navy-950">
      <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Shelby_County_Courthouse%2C_Adams_Avenue%2C_Memphis%2C_TN_%2853699223744%29.jpg?width=1920" alt="Courthouse entrance" class="absolute inset-0 w-full h-full object-cover kenburns" style="filter: grayscale(1) contrast(1.12) brightness(0.82);" loading="eager" />
      <div class="absolute inset-0" style="background-color:#0b1730; mix-blend-mode:multiply; opacity:0.78;"></div>
      <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 55% at 50% 42%, rgba(201,164,74,0.22) 0%, rgba(201,164,74,0) 60%);"></div>
      <div class="absolute inset-0" style="background: radial-gradient(ellipse 120% 100% at 50% 50%, transparent 55%, rgba(4,9,20,0.85) 100%), linear-gradient(180deg, rgba(4,9,20,0.35), transparent 30%, transparent 60%, rgba(4,9,20,0.95));"></div>

      <div class="relative h-full flex flex-col items-center justify-center text-center px-6">
        <img src="/images/logo-crest.png" alt="" class="h-16 sm:h-20 w-auto mb-6" style="filter: drop-shadow(0 0 24px rgba(201,164,74,0.5));" />
        <h1 class="font-serif font-medium text-cream-50 text-[44px] sm:text-7xl leading-[1.05] max-w-4xl" style="text-shadow: 0 2px 30px rgba(0,0,0,0.5);">
          No charge too serious.<br /> No case too small.
        </h1>
        <div class="glow-rule w-20 mt-8"></div>
        <p class="mt-7 text-cream-100/80 text-base sm:text-lg tracking-wide-sm max-w-xl">
          Prepared to take every case to trial — from DUI to homicide.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
          <a href={`tel:${PHONE_TEL}`} class="px-9 py-4 btn-foil text-sm tracking-wide-sm uppercase font-medium">
            Call {PHONE}
          </a>
          <a href="/contact" class="px-9 py-4 border border-cream-100/45 text-cream-50 text-sm tracking-wide-sm uppercase transition-all hover:border-gold-500 hover:text-gold-400 hover:shadow-[0_0_22px_rgba(201,164,74,0.25)]">
            Free Consultation
          </a>
        </div>
      </div>
    </div>

    <!-- Slim CTA utility bar directly under hero -->
    <div class="bg-navy-1000 border-t border-b border-gold-500/40">
      <a href={`tel:${PHONE_TEL}`} class="flex items-center justify-center gap-3 py-4 text-center">
        <span class="text-gold-400 text-xs sm:text-sm tracking-wide-lg uppercase" style="text-shadow: 0 0 18px rgba(201,164,74,0.4);">
          Free Consultation — Call 24/7 — {PHONE}
        </span>
      </a>
    </div>
  </section>

  <CountyBand />

  <!-- Closing band -->
  <section class="bg-navy-950 glow-top py-20 sm:py-24 noise">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <p class="text-gold-500 text-xs tracking-wide-lg uppercase mb-4 reveal" style="letter-spacing:0.3em;">
        Swift. Sharp. Strategic.
      </p>
      <h2 class="font-serif font-medium text-cream-50 text-3xl sm:text-4xl leading-snug reveal">
        Direct access to the attorney handling your case — from the first call.
      </h2>
      <a href="/contact" class="inline-block mt-10 px-9 py-4 btn-foil text-sm tracking-wide-sm uppercase font-medium reveal">
        Request a Free Consultation
      </a>
    </div>
  </section>
</BaseLayout>
