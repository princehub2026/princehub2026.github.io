---
import BaseLayout from "../layouts/BaseLayout.astro";
import CountyBand from "../components/CountyBand.astro";

const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<BaseLayout
  title="Trial Ready Criminal Defense"
  description="Yakubu Law is a Pennsylvania criminal defense practice prepared to take every case to trial — from DUI to homicide. Free consultation, available 24/7."
>
  <!-- Hero -->
  <section class="relative">
    <div class="relative h-[78vh] min-h-[560px] sm:h-[85vh] sm:min-h-[640px] w-full overflow-hidden">
      <img
        src="/images/placeholders/hero-home.jpg"
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(7,15,33,0.55) 0%, rgba(7,15,33,0.72) 55%, rgba(7,15,33,0.88) 100%);"></div>

      <div class="relative h-full flex flex-col items-center justify-center text-center px-6">
        <img src="/images/logo-crest.png" alt="" class="h-16 sm:h-20 w-auto mb-6 opacity-95" />
        <h1 class="font-serif text-white text-4xl sm:text-6xl leading-[1.08] max-w-3xl" style="color:#faf8f4;">
          No charge too serious.<br /> No case too small.
        </h1>
        <p class="mt-5 text-cream-100/90 text-base sm:text-lg tracking-wide-sm max-w-xl" style="color:rgba(244,240,232,0.9);">
          Prepared to take every case to trial — from DUI to homicide.
        </p>
        <div class="mt-9 flex flex-col sm:flex-row items-center gap-4">
          <a
            href={`tel:${PHONE_TEL}`}
            class="px-8 py-3.5 bg-gold-500 text-navy-950 text-sm tracking-wide-sm uppercase font-medium hover:bg-gold-400 transition-colors"
            style="background-color:#c4a24a; color:#070f21;"
          >
            Call {PHONE}
          </a>
          <a
            href="/contact"
            class="px-8 py-3.5 border border-cream-100/60 text-cream-50 text-sm tracking-wide-sm uppercase hover:border-gold-400 hover:text-gold-400 transition-colors"
            style="border-color: rgba(244,240,232,0.5); color:#faf8f4;"
          >
            Free Consultation
          </a>
        </div>
      </div>
    </div>

    <!-- Slim CTA utility bar directly under hero -->
    <div class="bg-navy-950 border-t border-b" style="background-color:#070f21; border-color: rgba(196,162,74,0.3);">
      <a href={`tel:${PHONE_TEL}`} class="flex items-center justify-center gap-3 py-4 text-center">
        <span class="text-gold-400 text-xs sm:text-sm tracking-wide-lg uppercase" style="color:#d9bf7c;">
          Free Consultation — Call 24/7 — {PHONE}
        </span>
      </a>
    </div>
  </section>

  <CountyBand />

  <!-- Closing band -->
  <section class="bg-navy-950 py-16 sm:py-20" style="background-color:#070f21;">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <p class="text-gold-400 text-xs tracking-wide-lg uppercase mb-3" style="color:#d9bf7c;">
        Swift. Sharp. Strategic.
      </p>
      <h2 class="font-serif text-cream-50 text-2xl sm:text-3xl" style="color:#faf8f4;">
        Direct access to the attorney handling your case — from the first call.
      </h2>
      <a
        href="/contact"
        class="inline-block mt-8 px-8 py-3.5 bg-gold-500 text-navy-950 text-sm tracking-wide-sm uppercase font-medium hover:bg-gold-400 transition-colors"
        style="background-color:#c4a24a; color:#070f21;"
      >
        Request a Free Consultation
      </a>
    </div>
  </section>
</BaseLayout>
