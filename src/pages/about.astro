---
import BaseLayout from "../layouts/BaseLayout.astro";
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<BaseLayout
  title="About Prince Charles Yakubu"
  description="Prince Charles Yakubu, founder of Yakubu Law — a Pennsylvania criminal defense practice built on direct access to the attorney and trial-ready preparation."
>
  <!-- Header band -->
  <section class="bg-navy-950 glow-top noise pt-16 pb-10 sm:pt-20 sm:pb-12 text-center">
    <img src="/images/logo-crest.png" alt="" class="h-10 w-auto mx-auto mb-5 opacity-90 crest-glow" />
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase">About</p>
    <h1 class="font-serif text-cream-50 text-4xl sm:text-5xl mt-3">Prince Charles Yakubu</h1>
    <div class="glow-rule w-16 mx-auto mt-6"></div>
    <a
      href={`tel:${PHONE_TEL}`}
      class="inline-block mt-6 text-gold-400 text-xs sm:text-sm tracking-wide-lg uppercase border-b border-gold-500 pb-1 hover:text-gold-300 transition-colors"
     
    >
      Free Consultation — Call 24/7: {PHONE}
    </a>
  </section>

  <!-- Hero: portrait + narrative -->
  <section class="bg-cream-50 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-6 grid sm:grid-cols-2 gap-10 sm:gap-16 items-start">
      <img
        src="/images/attorney-portrait.jpg"
        alt="Prince Charles Yakubu at the Montgomery County Courthouse"
        class="w-full aspect-[4/5] object-cover"
      />
      <div class="flex flex-col gap-5 text-navy-900/85 leading-relaxed">
        <p>
          Details win cases. I learned that as a law student, interning in the Homicide Unit
          of the Philadelphia District Attorney's Office — where a timestamp, a chain-of-custody
          form, or one line in a police report can be the whole case.
        </p>
        <p>
          Then I spent five years as a public defender. Every person I protected had been
          accused and needed someone in their corner. My job, to make sure the government
          proved exactly what it claimed it could prove, to the letter. In one case, it came
          down to two seconds out of hours of body camera footage — a single statement changed
          the outcome. That's the same attention to detail the DA's office taught me to
          respect, because that's often where cases are won.
        </p>
        <p>
          I started Yakubu Law to keep doing that work on my own terms — direct access to the
          attorney handling your case, not a rotation. Pennsylvania has been my home for over
          a decade, from my undergraduate years at Saint Joseph's University through Villanova
          Law. I represent clients across the state. Primarily Bucks, Chester, Delaware,
          Montgomery, and Philadelphia. DUI to homicide. No charge too serious. No case too
          small. Details matter. That's how results happen.
        </p>
      </div>
    </div>
  </section>

  <!-- Credentials line + SJU recognition module -->
  <section class="bg-navy-900 py-10 sm:py-12">
    <div class="mx-auto max-w-5xl px-6 flex flex-col items-center gap-8">
      <p class="text-cream-50 text-sm sm:text-base text-center">
        J.D., Villanova University Charles Widger School of Law, 2020
        <span class="text-gold-400 mx-2">&middot;</span>
        Licensed in Pennsylvania
        <span class="text-gold-400 mx-2">&middot;</span>
        PA Attorney ID 329066
      </p>

      <a
        href="https://www.sju.edu/outcomes/stories/prince-yakubu"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 bg-navy-950/60 hover:bg-navy-950 transition-colors px-4 py-3 max-w-md w-full"
        style="background-color:rgba(4,9,20,0.62);"
      >
        <img
          src="/images/placeholders/sju-photo.jpg"
          alt="Saint Joseph's University campus — photo to be added"
          class="w-16 h-16 sm:w-20 sm:h-20 object-cover flex-shrink-0"
        />
        <span class="text-left">
          <span class="block text-gold-400 text-[10px] tracking-wide-sm uppercase mb-1">
            Featured by Saint Joseph's University
          </span>
          <span class="block text-cream-100/75 text-xs leading-snug group-hover:text-cream-50 transition-colors">
            Accepted to all seven law schools he applied to. Read Prince's story on the path to Yakubu Law &rarr;
          </span>
        </span>
      </a>
    </div>
  </section>

  <!-- Photo band -->
  <section class="relative h-[42vh] min-h-[320px] sm:h-[52vh] w-full overflow-hidden">
    <img
      src="/images/courthouse-steps.jpg"
      alt="Attorney Prince Charles Yakubu on the courthouse steps"
      class="absolute inset-0 w-full h-full object-cover"
      style="filter: grayscale(0.35) contrast(1.06) brightness(0.9);"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background-color:#0b1730; mix-blend-mode:multiply; opacity:0.6;"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(201,164,74,0.16) 0%, rgba(201,164,74,0) 60%), linear-gradient(180deg, rgba(6,13,29,0.3) 0%, rgba(6,13,29,0.5) 100%);"></div>
  </section>

  <!-- What to expect -->
  <section class="bg-cream-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-gold-600 text-xs tracking-wide-lg uppercase text-center mb-10">What to Expect</p>
      <div class="grid sm:grid-cols-3 gap-10">
        {[
          { title: "Direct Access", body: "You will always be speaking with me, not staff standing in for me." },
          { title: "Clear Communication", body: "You'll know where your case stands, at every stage." },
          { title: "Trial-Ready Strategy", body: "Every case is prepared with the same rigor, whether it resolves through negotiation or in front of a jury." },
        ].map((item) => (
          <div class="text-center sm:text-left">
            <h3 class="font-serif text-lg text-navy-900 mb-2">{item.title}</h3>
            <p class="text-navy-900/70 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-navy-950 glow-top noise py-16 sm:py-20 text-center">
    <p class="text-gold-500 text-xs tracking-wide-lg uppercase mb-5" style="letter-spacing:0.3em;">Swift. Sharp. Strategic.</p>
    <a
      href={`tel:${PHONE_TEL}`}
      class="inline-block px-8 py-3.5 btn-foil text-sm tracking-wide-sm uppercase font-medium"
     
    >
      Free Consultation — Call 24/7
    </a>
  </section>
</BaseLayout>
