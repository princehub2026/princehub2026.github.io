---
import BaseLayout from "../layouts/BaseLayout.astro";
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<BaseLayout
  title="About Prince Charles Yakubu"
  description="Prince Charles Yakubu, founder of Yakubu Law — a Pennsylvania criminal defense practice built on direct access to the attorney and trial-ready preparation."
>
  <!-- Header band -->
  <section class="bg-navy-950 pt-16 pb-10 sm:pt-20 sm:pb-14 text-center" style="background-color:#070f21;">
    <img src="/images/logo-crest.png" alt="" class="h-10 w-auto mx-auto mb-5 opacity-90" />
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase" style="color:#d9bf7c;">About</p>
    <h1 class="font-serif text-cream-50 text-3xl sm:text-4xl mt-2" style="color:#faf8f4;">Prince Charles Yakubu</h1>
  </section>

  <!-- Hero: portrait + intro -->
  <section class="bg-cream-50 py-16 sm:py-24" style="background-color:#faf8f4;">
    <div class="mx-auto max-w-5xl px-6 grid sm:grid-cols-2 gap-10 sm:gap-16 items-center">
      <img
        src="/images/placeholders/attorney-portrait.jpg"
        alt="Attorney portrait — photo to be added"
        class="w-full aspect-[4/5] object-cover"
      />
      <div>
        <p class="font-serif text-xl sm:text-2xl leading-relaxed text-navy-900" style="color:#0a1630;">
          I founded Yakubu Law because <span class="text-navy-900/40" style="color:rgba(10,22,48,0.4);">[personal reason for choosing criminal defense — to be added]</span>.
        </p>
        <p class="mt-6 text-navy-900/80 leading-relaxed" style="color:rgba(10,22,48,0.8);">
          When you call this office, you reach me directly — not a paralegal, not a call center,
          not a junior associate handed your file. Every case I take gets my direct attention
          from the first call through the final outcome.
        </p>
      </div>
    </div>
  </section>

  <!-- Credentials row -->
  <section class="bg-navy-900 py-10 sm:py-12" style="background-color:#0a1630;">
    <div class="mx-auto max-w-5xl px-6 grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
      {[
        { icon: "M22 10v6M2 10l10-5 10 5-10 5-10-5zm4 2v5c3 3 9 3 12 0v-5", label: "Law School", value: "[to be added]" },
        { icon: "M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z", label: "Bar Admission", value: "Pennsylvania" },
        { icon: "M12 21c-4.5-4-8-7.5-8-11.5A8 8 0 0112 2a8 8 0 018 7.5c0 4-3.5 7.5-8 11.5z", label: "Counties Served", value: "5 PA Counties" },
        { icon: "M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z", label: "Founded", value: "[to be added]" },
      ].map((item) => (
        <div class="flex flex-col items-center gap-2">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:#c4a24a;"><path d={item.icon}/></svg>
          <p class="text-cream-50 text-sm font-medium" style="color:#faf8f4;">{item.value}</p>
          <p class="text-cream-100/50 text-[11px] tracking-wide-sm uppercase" style="color:rgba(244,240,232,0.5);">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Why I do this work -->
  <section class="py-16 sm:py-20" style="background-color:#f4f0e8;">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <p class="text-gold-600 text-xs tracking-wide-lg uppercase mb-4" style="color:#a9873a;">Why I Do This Work</p>
      <p class="font-serif text-xl sm:text-2xl leading-relaxed text-navy-900" style="color:#0a1630;">
        [Placeholder — a short, genuine paragraph on why criminal defense, to be added once provided]
      </p>
    </div>
  </section>

  <!-- Photo band -->
  <section class="relative h-[42vh] min-h-[320px] sm:h-[52vh] w-full overflow-hidden">
    <img
      src="https://commons.wikimedia.org/wiki/Special:FilePath/Shelby_County_Courthouse%2C_Adams_Avenue%2C_Memphis%2C_TN_%2853699323200%29.jpg?width=1920"
      alt="Courthouse exterior"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(7,15,33,0.15) 0%, rgba(7,15,33,0.35) 100%);"></div>
  </section>

  <!-- What to expect -->
  <section class="bg-cream-50 py-16 sm:py-20" style="background-color:#faf8f4;">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-gold-600 text-xs tracking-wide-lg uppercase text-center mb-10" style="color:#a9873a;">What to Expect</p>
      <div class="grid sm:grid-cols-3 gap-10">
        {[
          { title: "Direct Access", body: "You will always be speaking with me, not staff standing in for me." },
          { title: "Clear Communication", body: "You'll know where your case stands, at every stage." },
          { title: "Trial-Ready Strategy", body: "Every case is prepared with the same rigor, whether it resolves through negotiation or in front of a jury." },
        ].map((item) => (
          <div class="text-center sm:text-left">
            <h3 class="font-serif text-lg text-navy-900 mb-2" style="color:#0a1630;">{item.title}</h3>
            <p class="text-navy-900/70 text-sm leading-relaxed" style="color:rgba(10,22,48,0.7);">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-navy-950 py-16 sm:py-20 text-center" style="background-color:#070f21;">
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase mb-4" style="color:#d9bf7c;">Swift. Sharp. Strategic.</p>
    <a
      href={`tel:${PHONE_TEL}`}
      class="inline-block px-8 py-3.5 bg-gold-500 text-navy-950 text-sm tracking-wide-sm uppercase font-medium hover:bg-gold-400 transition-colors"
      style="background-color:#c4a24a; color:#070f21;"
    >
      Call {PHONE}
    </a>
  </section>
</BaseLayout>
