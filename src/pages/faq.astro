---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqTopics } from "../data/faq";
const PHONE = "484-944-0834";
const PHONE_TEL = PHONE.replace(/\D/g, "");
---
<BaseLayout
  title="FAQ"
  description="Answers to common questions about warrants, probation violations, return of property, and PFA orders in Pennsylvania."
>
  <section class="bg-navy-950 pt-16 pb-10 sm:pt-20 sm:pb-14 text-center" style="background-color:#070f21;">
    <p class="text-gold-400 text-xs tracking-wide-lg uppercase" style="color:#d9bf7c;">FAQ</p>
    <h1 class="font-serif text-cream-50 text-3xl sm:text-4xl mt-2" style="color:#faf8f4;">Common Questions</h1>
  </section>

  <section class="bg-cream-50 py-14 sm:py-20" style="background-color:#faf8f4;">
    <div class="mx-auto max-w-3xl px-6 space-y-16">
      {faqTopics.map((topic) => (
        <div id={topic.slug}>
          <h2 class="font-serif text-2xl sm:text-3xl text-navy-900" style="color:#0a1630;">{topic.title}</h2>
          <p class="mt-3 text-navy-900/75 leading-relaxed" style="color:rgba(10,22,48,0.75);">{topic.summary}</p>
          <p class="mt-3 text-navy-900/60 text-sm leading-relaxed" style="color:rgba(10,22,48,0.6);">
            <span class="text-gold-600 font-medium" style="color:#a9873a;">Consequences: </span>{topic.consequences}
          </p>

          <div class="mt-6 divide-y" style="border-color: rgba(196,162,74,0.25);">
            {topic.questions.map((item) => (
              <details class="group py-4 border-t" style="border-color: rgba(196,162,74,0.25);">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
                  <span class="text-navy-900 font-medium text-[15px]" style="color:#0a1630;">{item.q}</span>
                  <span class="text-gold-500 shrink-0 group-open:rotate-45 transition-transform" style="color:#c4a24a;">+</span>
                </summary>
                <p class="mt-3 text-navy-900/70 text-sm leading-relaxed" style="color:rgba(10,22,48,0.7);">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-navy-950 py-14 sm:py-16 text-center" style="background-color:#070f21;">
    <p class="text-cream-100/80 text-sm sm:text-base mb-6" style="color:rgba(244,240,232,0.8);">
      Don't see your question? Speak directly with the attorney.
    </p>
    <a
      href={`tel:${PHONE_TEL}`}
      class="inline-block px-8 py-3.5 bg-gold-500 text-navy-950 text-sm tracking-wide-sm uppercase font-medium hover:bg-gold-400 transition-colors"
      style="background-color:#c4a24a; color:#070f21;"
    >
      Call {PHONE}
    </a>
  </section>
</BaseLayout>
